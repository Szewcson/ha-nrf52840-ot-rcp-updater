diff --git a/scripts/west_commands/sbom/output_pre_process.py b/scripts/west_commands/sbom/output_pre_process.py
--- a/scripts/west_commands/sbom/output_pre_process.py
+++ b/scripts/west_commands/sbom/output_pre_process.py
@@ -19,2 +19,15 @@ def pre_process(data: Data):
-    data.files.sort(key=lambda f: f.file_path)
+    data.files.sort(key=lambda f: f.file_path)
+    # The source path is only meaningful to the build runner. Prepare the
+    # workspace-relative display path once so output templates never expose it.
+    for file in data.files:
+        file.report_path = file.file_rel_path.as_posix()
+    data.inputs = [
+        (
+            f'{input.rpartition("from the build directory ")[0]}'
+            'from the build directory "<local path>"'
+            if 'from the build directory "' in input
+            else input
+        )
+        for input in data.inputs
+    ]
     # Convert list of licenses to license expression for each file
